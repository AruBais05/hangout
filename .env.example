# Copy this file to .env.local and fill in your own values. .env.local is never committed.
# Every key here is optional: without them the app uses sample plans, the fixed quiz,
# OpenStreetMap and the demo card form, and still works end to end.

# AI provider is chosen in src/lib/config.ts (AI.provider). Only the matching key is needed.
# Groq (default, free tier): console.groq.com/keys
GROQ_API_KEY=
# Gemini (OpenAI-compatible endpoint): aistudio.google.com
GEMINI_API_KEY=
# Anthropic: console.anthropic.com
ANTHROPIC_API_KEY=

# Ticketmaster Discovery API (events on the chosen night): developer.ticketmaster.com
TICKETMASTER_API_KEY=

# Stripe TEST secret key (Dashboard → Developers → API keys, with "Test mode" on).
# Must start with sk_test_. Live keys are refused. Leave empty to use the built-in demo card form.
STRIPE_SECRET_KEY=

# Stripe TEST publishable key (pk_test_...). Not needed for hosted Checkout today; kept for later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Tax. Set to true only after you add an origin address in Dashboard → Tax.
STRIPE_AUTOMATIC_TAX=false

# Optional. With a key: Google Maps (JavaScript API + Places Autocomplete, and the Embed API).
# Without it: Leaflet + OpenStreetMap with search through our server (Nominatim).
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Supabase (free plan): real accounts, shared rooms and live updates. Leave empty for browser-only demo mode.
# Project Settings -> API. The URL and anon key are public by design (Row Level Security protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only. Used to save Stripe-verified Crew Pass purchases. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
